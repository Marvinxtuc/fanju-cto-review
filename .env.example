# Runtime
NODE_ENV=development
APP_ENV=local
APP_TIMEZONE=Asia/Shanghai

# API
API_BASE_URL=http://localhost:3000
API_PORT=3000
SESSION_COOKIE_NAME=
SESSION_SECRET=

# Database
DATABASE_URL=postgresql://timeleft:timeleft_dev_password@localhost:5432/timeleft_shanghai?schema=public

# Cache / Jobs
REDIS_URL=
JOB_WORKER_ENABLED=false

# WeChat Mini Program Auth / Phone
AUTH_PROVIDER=mock
PHONE_PROVIDER=mock
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_LOGIN_MOCK_ENABLED=true
WECHAT_PHONE_MOCK_ENABLED=true

# WeChat Pay Provider Boundary
PAYMENT_PROVIDER=mock
REFUND_PROVIDER=mock
WECHAT_PAY_ENABLED=false
ALLOW_MOCK_PAYMENT_IN_PRODUCTION=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_CALLBACK_URL=
WECHAT_REFUND_CALLBACK_URL=

# Map / Navigation
MAP_PROVIDER=wechat
MAP_API_KEY=

# Notifications
NOTIFICATION_MODE=in_app
WECHAT_SUBSCRIBE_MESSAGE_ENABLED=false

# Security / Compliance
FORBIDDEN_WORD_SCAN_ENABLED=true
AUDIT_LOG_REQUIRED=true
PII_LOG_MASKING_ENABLED=true

# Feature Flags
FEATURE_REAL_WECHAT_PAY=false
FEATURE_WECHAT_SUBSCRIBE_MESSAGE=false
FEATURE_AUTO_ADDRESS_UNLOCK=false
FEATURE_MERCHANT_PORTAL=false

# Explicit isolated local demo only; never enable on an externally reachable deployment.
LOCAL_DEMO_ENABLED=false
# Ops production defaults to same-origin API; miniapp production requires an explicit URL.
VITE_API_BASE_URL=
# Exact comma-separated browser origins allowed to call the API across origins.
# Keep empty for a same-origin production deployment.
OPS_ALLOWED_ORIGINS=
TARO_APP_API_BASE_URL=

# Development miniapp only; production builds reject true.
TARO_APP_DEMO_MODE=false

# Non-demo session signing key: inject a random value of at least 32 characters.
# Increment SESSION_VERSION and restart all API instances to revoke all sessions.
SESSION_VERSION=1
# Comma-separated internal subject IDs; requires all API instances to reload.
SESSION_REVOKED_SUBJECTS=
# JSON controlled account list; inject outside repo. Never put passwords here.
OPS_ACCOUNTS_JSON=
VITE_DEMO_MODE=false

# Stops NEW charges only; leave real providers and callback verification configured for existing transactions.
NEW_PAYMENTS_ENABLED=false
REAL_PAYMENT_APPROVAL_ID=
REAL_PAYMENT_ALLOWED_USER_IDS=
REAL_PAYMENT_MAX_AMOUNT_CENTS=
REQUIRED_BILL_SCOPE=
REQUIRED_BILL_PERIOD=

# Recovery processes: events-only and inbox-only never dispatch channel requests.
WORKER_MODE=local-recovery
# Comma-separated modes required by /ready. Production defaults to events-only,inbox-only.
REQUIRED_WORKER_MODES=
RELEASE_VERSION=local-unversioned
FINANCIAL_CASE_OWNER=local-review-required
WECHAT_PAY_CONFIG_VERSION=wechat-v1

# Formal assembly defaults closed. Independent grants and evidence remain outside repo.
FEATURE_V11_FORMAL_BUSINESS=false
FEATURE_V11_FORMAL_PAYMENT=false
V11_FORMAL_CASE_OWNER=
V11_FORMAL_AUTHORITY_REGISTRY_PATH=
V11_FORMAL_AUTHORITY_REGISTRY_SHA256=
# Single-policy alternative (registry is recommended for historical obligations).
V11_FORMAL_AUTHORITY_PATH=
V11_FORMAL_AUTHORITY_SHA256=
V11_FORMAL_AUTHORITY_SIGNATURE=
V11_FORMAL_AUTHORITY_PUBLIC_KEY_PATH=
V11_FORMAL_AUTHORITY_ISSUER_ID=
V11_FORMAL_AUTHORITY_EVIDENCE_PATH=
V11_FORMAL_AUTHORITY_REVOCATIONS_PATH=
# Formal miniapp main pages are enabled in a non-demo build; API must be configured.
TARO_APP_FORMAL_BUSINESS=true
